# Deny by default: nothing is tracked unless it is allowed below, by name (org ADR-0003).
# Adding a file to the repository therefore means adding it here first, which makes publishing a
# file a deliberate, reviewable act instead of an accident.

# Ignore everything ...
**

# ... then allow each directory that holds a tracked file. Git does not look inside an ignored
# directory, so every directory on the way to an allowed file is listed. This allows no file.
!/.github/
!/.github/.config/
!/.github/workflows/
!/docs/
!/docs/decision-records/
!/docs/decision-records/org/
!/example/
!/example/repository/
!/example/template/
!/tests/
!/tools/
!/workflow_template_drift/

# The checker: a Python package and the image it ships in.
!/workflow_template_drift/__init__.py
!/workflow_template_drift/__main__.py
!/workflow_template_drift/checker.py
!/Containerfile
!/.dockerignore
!/VERSION

# The tests, and the example they share with the README.
!/tests/host.sh
!/tests/image.sh
!/tests/test_checker.py
!/example/expected-report.txt
!/example/repository/CHANGELOG.md
!/example/repository/legacy.cfg
!/example/repository/lint.toml
!/example/repository/pipeline.yaml
!/example/template/lint.toml
!/example/template/pipeline.yaml
!/example/template/template-drift.json

# Tools: the local run of the check, its pre-commit hook, and the release pipeline's registry client.
!/tools/template-drift.sh
!/tools/install-crane.sh
!/.pre-commit-hooks.yaml

# Continuous integration, the release pipeline, and the workflow other repositories call.
!/.github/workflows/ci.yaml
!/.github/workflows/publish.yaml
!/.github/workflows/check.yaml
!/.github/workflows/workflow-containers.yaml
!/.github/renovate.json5
!/.github/CODEOWNERS

# This repository's own template-drift setup: the templates it follows and the commits it pins.
!/.github/.config/template-drift.yaml
!/.github/.config/template-drift.lock

# Documents, and the organization's decision records that the drift check verifies.
!/README.md
!/LICENSE
!/SECURITY.md
!/docs/decision-records/org/.gitkeep
!/docs/decision-records/org/0001-use-architecture-decision-records.md
!/docs/decision-records/org/0002-adopt-diataxis-documentation-framework.md
!/docs/decision-records/org/0003-use-deny-all-gitignore-strategy.md
!/docs/decision-records/org/0004-use-renovate-for-dependency-updates.md
!/docs/decision-records/org/0005-keep-github-control-planes-namespace-local.md

# Repository settings for editors and for Git.
!/.editorconfig
!/.gitattributes
!/.gitignore
