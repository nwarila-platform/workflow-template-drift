# =========================================================================================== #
# File: '.gitignore'
# --- [ Description ] ----------------------------------------------------------------------- #
#
# DEFAULT-DENY, EXPLICIT INCLUDES ONLY. Nothing in this working tree is tracked unless it is
# explicitly allowed below, by name. Adding any new file therefore requires allowing it here
# first -- that is deliberate: it makes publishing a file an explicit act rather than an accident.
#
# =========================================================================================== #

# Ignore everything ...
**

# --- [ directory spine ] -------------------------------------------------------------------- #
# Git does not descend into an excluded directory, so every directory on the path to an
# allowed file is re-included by name. This publishes no files by itself.
!/.github/
!/.github/renovate.json5
!/.github/workflows/
!/fixtures/
!/fixtures/determinism/
!/fixtures/determinism/source/
!/fixtures/determinism/source/template/
!/fixtures/determinism/workspace/
!/fixtures/determinism/workspace/consumer/
!/fixtures/goldens/
!/tests/
!/tools/
!/workflow_template_drift/

# --- [ allowed: repository configuration ] -------------------------------------------------- #
!/.dockerignore
!/.gitignore
!/.pre-commit-hooks.yaml

# --- [ allowed: top-level documents ] ------------------------------------------------------- #
!/LICENSE
!/README.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md

# --- [ allowed: GitHub configuration ] ------------------------------------------------------ #
!/.github/CODEOWNERS
!/.github/workflows/ci.yaml
!/.github/workflows/check.yaml
!/.github/workflows/publish.yaml

# --- [ allowed: the checker ] --------------------------------------------------------------- #
!/Containerfile
!/workflow_template_drift/__init__.py
!/workflow_template_drift/__main__.py
!/workflow_template_drift/engine.py

# --- [ allowed: the publish pipeline's pinned registry client and the release version ] ----- #
!/tools/install-crane.sh
!/tools/template-drift.sh
!/VERSION

# --- [ allowed: the evidence harness ] ------------------------------------------------------ #
!/tests/__init__.py
!/tests/support.py
!/tests/test_determinism.py
!/tests/test_engine.py
!/tests/test_git_patch.py
!/fixtures/determinism/source/drift.json
!/fixtures/determinism/source/template/file.txt
!/fixtures/determinism/workspace/consumer/file.txt
!/fixtures/goldens/determinism.text
!/fixtures/goldens/determinism.patch

# --- [ never tracked, even by a future allowance ] ------------------------------------------ #
# Local no-pip runtime, test artifacts, the CI harness copy, and bytecode caches.
/.runtime/
/artifacts/
/.ci-harness/
__pycache__/
