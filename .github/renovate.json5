{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>nwarila-platform/pdq-deploy-inventory//.github/renovate.json5"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/(check|workflow-containers)\\.yaml$/"],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "loose",
      "matchStrings": [
        "# renovate: datasource=git-refs depName=(?<depName>[^\\s]+) packageName=(?<packageName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)\\s+uses: [^@\\s]+@(?<currentDigest>[0-9a-f]{40})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["nwarila-platform/**", "NWarila/**"],
      "minimumReleaseAge": null
    },
    {
      // Hold the organization runner pin in check.yaml. Contract 2 of run-container.yaml
      // (nwarila-platform/.github 95ca3c2, 2026-10-08) takes different inputs, so a SHA-only
      // update would call it with contract-1 inputs. This repository moves by hand when it
      // switches to contract 2.
      "matchDepNames": ["nwarila-platform/.github"],
      "enabled": false
    }
  ]
}
